{
  "name": "@cms/docs-types",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-types": "^12.1.3"
  },
  "devDependencies": {
    "@cms/icons": "workspace:*",
    "@cms/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/unist": "^3.0.3",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unist-builder": "4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
