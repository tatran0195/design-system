{
  "name": "@cms/dashboard",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**",
    "licenses",
    "NOTICE.md",
    "DASHBOARD.md",
    "DASHBOARD-MIGRATION.md",
    "DASHBOARD-VALIDATION.md",
    "src/upstream-manifest.json"
  ],
  "scripts": {
    "audit": "bun scripts/audit-dashboard.mjs",
    "audit:dashboard": "bun scripts/audit-dashboard.mjs",
    "build": "tsdown",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:dashboard": "vitest run",
    "typecheck": "tsc --noEmit",
    "watch": "tsdown --watch"
  },
  "dependencies": {
    "@ariakit/react": "^0.4.15",
    "@base-ui/react": "^1.9.0",
    "@cms/icons": "workspace:*",
    "@cms/ui": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/error-message": "^2.0.1",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-table": "^9.2.8",
    "@tanstack/react-virtual": "^3.13.12",
    "@uiw/react-json-view": "^2.0.0-alpha.17",
    "bignumber.js": "^9.3.1",
    "copy-to-clipboard": "^4.0.2",
    "date-fns": "^4.1.0",
    "lodash.debounce": "^4.0.8",
    "match-sorter": "^8.1.0",
    "motion": "^14.1.0",
    "react-currency-input-field": "^4.0.13",
    "react-hook-form": "^7.90.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cms/tsconfig": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-dom": "*"
  }
}
