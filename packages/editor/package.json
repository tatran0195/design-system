{
  "name": "@cms/editor",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./tiptap.css": "./src/tiptap.css"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "src",
    "licenses",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache dist node_modules",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cms/i18n": "workspace:*",
    "@cms/ui": "workspace:*",
    "@tiptap/core": "3.31.0",
    "@tiptap/extension-character-count": "3.31.0",
    "@tiptap/extension-code-block-lowlight": "3.31.0",
    "@tiptap/extension-drag-handle-react": "3.31.0",
    "@tiptap/extension-highlight": "3.31.0",
    "@tiptap/extension-image": "3.31.0",
    "@tiptap/extension-placeholder": "3.31.0",
    "@tiptap/extension-subscript": "3.31.0",
    "@tiptap/extension-superscript": "3.31.0",
    "@tiptap/extension-table": "3.31.0",
    "@tiptap/extension-table-cell": "3.31.0",
    "@tiptap/extension-table-header": "3.31.0",
    "@tiptap/extension-table-row": "3.31.0",
    "@tiptap/extension-task-item": "3.31.0",
    "@tiptap/extension-task-list": "3.31.0",
    "@tiptap/extension-typography": "3.31.0",
    "@tiptap/pm": "3.31.0",
    "@tiptap/react": "3.31.0",
    "@tiptap/starter-kit": "3.31.0",
    "@tiptap/suggestion": "3.31.0",
    "lowlight": "3.3.0",
    "tiptap-markdown": "0.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cms/tsconfig": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@tiptap/extension-text-align": "3.31.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
